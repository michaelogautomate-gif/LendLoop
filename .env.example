# ============================================================================
# 1. CLERK AUTHENTICATION (https://dashboard.clerk.com)
# Create a Clerk JWT Template using the "Convex" preset (named exactly: convex)
# ============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# ============================================================================
# 2. CONVEX LOCAL DEPLOYMENT (`npx convex dev --local`)
# Local Client API runs on 3210; Local HTTP Actions run on 3211
# ============================================================================
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
CONVEX_SITE_URL=http://127.0.0.1:3211
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# ============================================================================
# 3. BIDIRECTIONAL AUTOMATION & SECURITY SECRETS
# Generate with: npm run secrets:generate
# Sync to Convex with: npm run convex:env
# ============================================================================
# Shared HMAC-SHA256 secret used by Convex to sign outbound webhooks to n8n
N8N_WEBHOOK_SECRET=replace_with_64_hex_chars_from_secrets_generate

# Shared HMAC-SHA256 secret used by n8n to sign requests to Convex HTTP endpoints
CONVEX_AUTOMATION_SECRET=replace_with_64_hex_chars_from_secrets_generate

# n8n Webhook URL called by Convex when borrow requests are created or updated
N8N_LOAN_EVENT_WEBHOOK_URL=http://127.0.0.1:5678/webhook/lendloop-loan-event

# Verified Clerk email address that receives initial "admin" role on bootstrap
ADMIN_BOOTSTRAP_EMAIL=your-verified-email@example.com

# Local demo seeding toggle (set false in production)
ALLOW_DEMO_SEED=true
NEXT_PUBLIC_ENABLE_DEMO_SEED=true

# ============================================================================
# 4. DOCKER COMPOSE / n8n LOCAL CONFIGURATION
# ============================================================================
N8N_ENCRYPTION_KEY=replace_with_64_hex_chars_from_secrets_generate
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
CONVEX_HTTP_BASE_URL=http://host.docker.internal:3211
SMTP_HOST=mailpit
SMTP_PORT=1025
LENDLOOP_FROM_EMAIL=LendLoop Neighborhood <noreply@lendloop.local>
LENDLOOP_OPS_EMAIL=ops-alerts@lendloop.local
